# ── Groq API Keys ─────────────────────────────────────────────────────────────
# Primary / fallback key (required). All services fall back to this if their
# dedicated key is not set.
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: dedicated key for LLM calls (routing, reasoning, orchestration).
# Set this to isolate LLM quota from STT/TTS usage.
GROQ_LLM_API_KEY=

# Optional: dedicated key for STT (Whisper transcription).
GROQ_STT_API_KEY=

# Optional: dedicated key for TTS (PlayAI text-to-speech).
GROQ_TTS_API_KEY=

# ── Groq Endpoints & Models ────────────────────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI

# ── LLM Model Selection ────────────────────────────────────────────────────────
ROUTING_MODEL=openai/gpt-oss-20b
REASONING_MODEL=openai/gpt-oss-120b
ORCHESTRATOR_MODEL=openai/gpt-oss-120b

# ── Qwen (optional, via Together AI or similar) ────────────────────────────────
QWEN_MODEL=qwen/qwen3-32b
QWEN_API_BASE=https://api.together.xyz/v1
QWEN_API_KEY=

# ── Embedding Provider ─────────────────────────────────────────────────────────
# Choose one: huggingface | openai | jina
EMBEDDING_PROVIDER=huggingface
# Model for EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_FALLBACK_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Jina AI Embeddings (required when EMBEDDING_PROVIDER=jina) ────────────────
# Get your free key at: https://jina.ai/embeddings/
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_API_URL=https://api.jina.ai/v1/embeddings

# ── OpenAI (optional — TTS fallback or OpenAI embeddings) ─────────────────────
OPENAI_API_KEY=

# ── RAG / Vector Search ────────────────────────────────────────────────────────
RAG_INDEX_NAME=AilixirDocs
RAG_TOP_K=5
RAG_ALPHA=0.5

# ── External Microservices ─────────────────────────────────────────────────────
ADMET_AI_URL=https://shdwRow-ailixir-admet.hf.space
CHEMICAL_AI_URL=https://RottenShadow-ailixir-chemical-rag.hf.space
DRUG_REPURPOSING_URL=https://RottenShadow-ailixir-drug-repurposing.hf.space
GENERATION_SERVICE_URL=https://shdwRow-ailixir-generation.hf.space

# ── Chemical MCP Server ────────────────────────────────────────────────────────
CHEMICAL_MCP_URL=http://localhost:8001/mcp
MCP_SERVER_PORT=8001

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://omar_yasser_311:omar_yasser_311@cluster0.8pykbmn.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ailixir

# ── Redis (short-term memory) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Weaviate Vector DB ─────────────────────────────────────────────────────────
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── CORS / Frontend ────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use "*" for dev only.
CORS_ORIGINS=*
FRONTEND_URL=https://scientific-operating-system.vercel.app

# ── Voice Pipeline ─────────────────────────────────────────────────────────────
VOICE_DEBUG=0

# ── Docker / Compose knobs ─────────────────────────────────────────────────────
# PRELOAD_MODEL=1  → bake HF embedding model into image (~560 MB extra, no cold-start)
#                    Only useful when EMBEDDING_PROVIDER=huggingface
# PRELOAD_MODEL=0  → default; model downloads on first container start (2-3 min)
PRELOAD_MODEL=0
# HOST_PORT=7860
# WEAVIATE_VERSION=latest
# START_MCP_SERVER=1   # 0 = run MCP server elsewhere, set CHEMICAL_MCP_URL
