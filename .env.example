# Groq LLM Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# External Microservices
ADMET_AI_URL=https://shdwRow-ailixir-admet.hf.space
CHEMICAL_AI_URL=https://RottenShadow-ailixir-chemical-rag.hf.space
DRUG_REPURPOSING_URL=https://RottenShadow-ailixir-drug-repurposing.hf.space
GENERATION_SERVICE_URL=https://shdwRow-ailixir-generation.hf.space

# ── Auth (required for /api/v1/auth) ─────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
MONGODB_URI=
MONGODB_DB_NAME=ailixir

# ── Optional ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# ── Docker / compose knobs ───────────────────────────────────────────────────
# PRELOAD_MODEL=1        # 0 = don't bake the embedding model into the image
# START_MCP_SERVER=1     # 0 = run the chemical MCP server elsewhere + set CHEMICAL_MCP_URL
# HOST_PORT=7860
# WEAVIATE_VERSION=latest
