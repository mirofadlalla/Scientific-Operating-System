# ════════════════════════════════════════════════════════════════════════════════
# AI-lixir Scientific OS — environment variables reference
# Copy to .env and fill in values marked REQUIRED.
# Everything else has a sensible default and can be left blank.
# ════════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  GROQ API KEYS                                                              │
# │  Get yours at: https://console.groq.com/keys                                │
# └─────────────────────────────────────────────────────────────────────────────┘
# REQUIRED — primary / fallback key used by any service that has no dedicated key.
GROQ_API_KEY=your_groq_api_key_here

# Optional dedicated key for LLM calls (routing, reasoning, orchestration).
# Lets you separate LLM quota/billing from voice services.
# Falls back to GROQ_API_KEY when not set.
GROQ_LLM_API_KEY=

# Optional dedicated key for STT (Groq Whisper transcription).
# Falls back to GROQ_API_KEY when not set.
GROQ_STT_API_KEY=

# Optional dedicated key for TTS (Groq PlayAI / Orpheus text-to-speech).
# Falls back to GROQ_API_KEY when not set.
GROQ_TTS_API_KEY=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  GROQ ENDPOINTS & MODELS                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘
GROQ_BASE_URL=https://api.groq.com/openai/v1

# STT model (Whisper)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# TTS models (Orpheus family via Groq)
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
GROQ_TTS_MODEL_ARABIC=canopylabs/orpheus-arabic-saudi
GROQ_TTS_MODEL_ENGLISH=canopylabs/orpheus-v1-english

# OpenAI TTS fallback model (used when Groq TTS fails and OPENAI_API_KEY is set)
OPENAI_TTS_MODEL=tts-1


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  LLM MODEL SELECTION                                                        │
# └─────────────────────────────────────────────────────────────────────────────┘
ROUTING_MODEL=openai/gpt-oss-20b       # fast intent routing
REASONING_MODEL=openai/gpt-oss-120b    # heavy biomedical reasoning
ORCHESTRATOR_MODEL=openai/gpt-oss-120b # backward-compat alias for REASONING_MODEL


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  QWEN (optional — orchestrator brain)                                       │
# └─────────────────────────────────────────────────────────────────────────────┘
QWEN_MODEL=qwen/qwen3-32b
QWEN_API_BASE=https://api.together.xyz/v1
QWEN_API_KEY=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  EMBEDDING PROVIDER                                                         │
# │  Choose: huggingface | openai | jina                                        │
# │                                                                             │
# │  huggingface → runs locally (CPU), ~560 MB, 2-3 min cold-start             │
# │  jina        → REST API, requires JINA_API_KEY, no GPU/RAM cost            │
# │  openai      → REST API, requires OPENAI_API_KEY                            │
# └─────────────────────────────────────────────────────────────────────────────┘
EMBEDDING_PROVIDER=huggingface

# Model for EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# Last-resort fallback model (if primary fails to load)
EMBEDDING_FALLBACK_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  JINA AI EMBEDDINGS  (only required when EMBEDDING_PROVIDER=jina)          │
# │  Free tier available — get your key at: https://jina.ai/embeddings/        │
# └─────────────────────────────────────────────────────────────────────────────┘
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_API_URL=https://api.jina.ai/v1/embeddings


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  OPENAI  (optional)                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
# Used for: TTS fallback (alloy, nova, shimmer…) or OpenAI embeddings.
OPENAI_API_KEY=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  RAG / VECTOR SEARCH                                                        │
# └─────────────────────────────────────────────────────────────────────────────┘
RAG_INDEX_NAME=AilixirDocs   # Weaviate collection name
RAG_TOP_K=5                  # number of chunks retrieved per query
RAG_ALPHA=0.5                # hybrid-search weight: 0=BM25 only, 1=vector only


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  EXTERNAL MICROSERVICES                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘
ADMET_AI_URL=https://shdwRow-ailixir-admet.hf.space
CHEMICAL_AI_URL=https://RottenShadow-ailixir-chemical-rag.hf.space
DRUG_REPURPOSING_URL=https://RottenShadow-ailixir-drug-repurposing.hf.space
GENERATION_SERVICE_URL=https://shdwRow-ailixir-generation.hf.space


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  CHEMICAL MCP SERVER                                                        │
# └─────────────────────────────────────────────────────────────────────────────┘
# If START_MCP_SERVER=0, set CHEMICAL_MCP_URL to your external MCP endpoint.
CHEMICAL_MCP_URL=http://localhost:8001/mcp
MCP_SERVER_PORT=8001


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  AUTH / JWT                                                                 │
# └─────────────────────────────────────────────────────────────────────────────┘
# REQUIRED in production — generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  MONGODB ATLAS                                                              │
# └─────────────────────────────────────────────────────────────────────────────┘
# Format: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=ailixir


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  REDIS  (short-term memory)                                                 │
# └─────────────────────────────────────────────────────────────────────────────┘
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  WEAVIATE VECTOR DB                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  CORS / FRONTEND                                                            │
# └─────────────────────────────────────────────────────────────────────────────┘
# CORS_ORIGINS: comma-separated list of allowed origins.
#   Dev:        CORS_ORIGINS=*
#   Production: CORS_ORIGINS=https://my-app.vercel.app,https://staging.my-app.vercel.app
CORS_ORIGINS=*
FRONTEND_URL=https://scientific-operating-system.vercel.app


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  VOICE PIPELINE                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
VOICE_DEBUG=0   # set to 1 for verbose audio/voice logging


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  DOCKER / COMPOSE KNOBS                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘
# PRELOAD_MODEL=0  (default) — no model weights in image; downloads on first start.
# PRELOAD_MODEL=1             — bakes the HF model into the image (+560 MB).
#                               Only useful for EMBEDDING_PROVIDER=huggingface.
#                               jina and openai are API-only — always keep at 0.
PRELOAD_MODEL=0

# HOST_PORT=7860
# WEAVIATE_VERSION=latest
# START_MCP_SERVER=1   # 0 = run the MCP server externally, then set CHEMICAL_MCP_URL
